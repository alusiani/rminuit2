# Detect the number of processors
NPROCS := 1
OS := $(shell uname -s)

ifeq ($(OS),Linux)
  NPROCS := $(shell nproc)
endif

ifeq ($(OS),Darwin) # macOS
  NPROCS := $(shell sysctl -n hw.ncpu)
endif

CHECK_CXX := $(firstword $(CXX))

# Check if the compiler supports -std=c++20 by attempting a dry-run compilation.
# The original -v --help approach piped stderr to grep but redirected stderr to
# /dev/null, so grep received nothing and the check always failed.
HAS_CPP20 := $(shell $(CHECK_CXX) -std=c++20 -x c++ /dev/null -fsyntax-only 2>/dev/null && echo "yes")

ifeq ($(HAS_CPP20),yes)
  CXX20 := $(CHECK_CXX)
  CXX20STD := -std=c++20
  CXX20PICFLAGS := -fPIC
  CXX20FLAGS := -g -O2 $(CXX20PICFLAGS)
  export CXX20
  export CXX20STD
endif

# Minuit2
MINUIT_DIR = minuit2/math/minuit2
MINUIT_INC = $(MINUIT_DIR)/dist/include/Minuit2

# Static library paths (used both as build prerequisites and for portable linking)
MINUIT_LIB = $(MINUIT_DIR)/dist/lib/libMinuit2.a
MATH_LIB   = $(MINUIT_DIR)/dist/lib/libMinuit2Math.a

# R Glue Code
GLUE_OBJECTS = rminuit2.o RcppExports.o

PKG_CPPFLAGS = -I$(MINUIT_INC)

# PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)

PKG_LIBS = $(MINUIT_LIB) $(MATH_LIB)

# Dependency Files
ALL_OBJS = $(GLUE_OBJECTS)
DEPS = $(ALL_OBJS:.o=.d)

# --- Build Rules ---

all: $(SHLIB)

# Include the generated dependency files
-include $(DEPS)

$(SHLIB): $(MINUIT_LIB) $(MATH_LIB) $(GLUE_OBJECTS)

rminuit2.o $(MINUIT_LIB) $(MATH_LIB): prepare

.PHONY: prepare
prepare:
	mkdir -p $(MINUIT_DIR)/build ; \
	cd $(MINUIT_DIR)/build ; \
	cmake .. \
		-Dminuit2_standalone=ON \
		-Dminuit2_omp=ON \
		-DCMAKE_INSTALL_PREFIX="../dist" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_POSITION_INDEPENDENT_CODE=ON \
		-DCMAKE_CXX_FLAGS="-include ${PWD}/assert_throw.h" \
		; \
	make -j$(NPROCS) ; \
	make install

# specialized rules
# SHLIB_OPENMP_CXXFLAGS -- ensure OPENMP
# -MMD -MP -MF $*.d -- dependency file generation;

rminuit2.o: %.o: %.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(SHLIB_OPENMP_CXXFLAGS) -MMD -MP -MF $*.d -I. -c $< -o $@

%.o: %.cxx
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(SHLIB_OPENMP_CXXFLAGS) -MMD -MP -MF $*.d -c $< -o $@

# Cleanup
clean:
	@\rm -rf \
		$(GLUE_OBJECTS) \
		$(DEPS) $(MINUIT_LIB) $(MATH_LIB) $(SHLIB) \
		rminuit2.so a-RcppExports.d a-rminuit2.d \
		$(MINUIT_DIR)/build $(MINUIT_DIR)/dist
