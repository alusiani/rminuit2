# Or just use the name directly if you prefer
CHECK_CXX = x86_64-conda-linux-gnu-c++

# 2. Check if the compiler exists and supports -std=c++20
# We redirect stderr to dev/null so it fails silently if the flag is unknown
HAS_CPP20 := $(shell if $(CHECK_CXX) -v --help 2>/dev/null | grep -q "std=c++20"; then echo "yes"; fi)

# 3. Only define CXX20 if the check passed
ifeq ($(HAS_CPP20),yes)
  CXX20 = $(CHECK_CXX)
endif

# 1. Define Paths
MINUIT_DIR = minuit2/math/minuit2
MINUIT_INC = $(MINUIT_DIR)/dist/include/Minuit2

# R Glue Code
GLUE_OBJECTS = rminuit2.o RcppExports.o

PKG_CPPFLAGS = \
  -I$(MINUIT_INC) -I$(MINUIT_INC)/Minuit2 \
  $(SHLIB_OPENMP_CXXFLAGS) -MMD -MP -MF $*.d

PKG_LIBS = -L$(MINUIT_DIR)/dist/lib -Wl,-Bstatic -lMinuit2 -lMinuit2Math -Wl,-Bdynamic -lVc

# Define the library location
MINUIT_LIB = $(MINUIT_DIR)/dist/lib/libMinuit2.a
MATH_LIB = $(MINUIT_DIR)/dist/lib/libMinuit2Math.a

# 6. Dependency Files
ALL_OBJS = $(GLUE_OBJECTS)
DEPS = $(ALL_OBJS:.o=.d)

# --- Build Rules ---

all: $(SHLIB)

# Include the generated dependency files
-include $(DEPS)

$(SHLIB): $(MINUIT_LIB) $(MATH_LIB) $(GLUE_OBJECTS)

$(MINUIT_LIB) $(MATH_LIB):
	mkdir -p $(MINUIT_DIR)/build
	cd $(MINUIT_DIR)/build ; \
	cmake .. \
    -Dminuit2_standalone=ON \
    -Dminuit2_omp=ON \
    -DCMAKE_INSTALL_PREFIX="../dist" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
		-DCMAKE_CXX_FLAGS="-include ${PWD}/assert_throw.h" \
		; \
	make ; \
	make install

rminuit2.o: %.o: %.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -I. -c $< -o $@

# Generic rule for C++ files
%.o: %.cxx
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -c $< -o $@

# R / Rcpp does that by default apparently
# %.o: %.cpp
# 	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -c $< -o $@

# Cleanup
clean:
	@\rm -rf \
	  $(GLUE_OBJECTS) \
		$(DEPS) $(MINUIT_LIB) $(MATH_LIB) $(SHLIB) \
		a-RcppExports.d a-rminuit2.d \
		$(MINUIT_DIR)/build $(MINUIT_DIR)/dist
